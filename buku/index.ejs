<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manajemen Buku Perpustakaan</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container" style="max-width: 900px; margin: 30px auto; font-family: sans-serif;">
        <h2>📚 Daftar Buku Perpustakaan</h2>
        <a href="/buku/add" style="display: inline-block; margin-bottom: 15px; padding: 8px 15px; background: #28a745; color: white; text-decoration: none; border-radius: 4px;">+ Tambah Buku Baru</a>
        
        <table border="1" cellpadding="10" cellspacing="0" style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background: #f8f9fa;">
                    <th>ID</th>
                    <th>Judul</th>
                    <th>Penulis</th>
                    <th>Kategori</th>
                    <th>Tahun</th>
                    <th>Stok</th>
                    <th>Aksi</th>
                </tr>
            </thead>
            <tbody>
                <% if (buku.length > 0) { %>
                    <% buku.forEach(item => { %>
                        <tr>
                            <td><%= item.id %></td>
                            <td><%= item.judul %></td>
                            <td><%= item.penulis %></td>
                            <td><%= item.kategori %></td>
                            <td><%= item.tahun_terbit %></td>
                            <td><%= item.stok %></td>
                            <td>
                                <a href="/buku/edit/<%= item.id %>" style="color: #007bff; text-decoration: none; margin-right: 10px;">Edit</a>
                                <form action="/buku/delete/<%= item.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Yakin ingin menghapus buku ini?');">
                                    <button type="submit" style="background: #dc3545; color: white; border: none; padding: 4px 8px; cursor: pointer; border-radius: 3px;">Hapus</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="7" style="text-align: center;">Belum ada data buku.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</body>
</html>